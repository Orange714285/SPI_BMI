namespace foxglove;

table CarData
{
    state : int;

    acc_raw_frd_x_mg : float;
    acc_raw_frd_y_mg : float;
    acc_raw_frd_z_mg : float;

    acc_filtered_frd_x_mg : float;
    acc_filtered_frd_y_mg : float;
    acc_filtered_frd_z_mg : float;

    gyro_raw_frd_x_dps : float;
    gyro_raw_frd_y_dps : float;
    gyro_raw_frd_z_dps : float;

    gyro_filtered_frd_x_dps : float;
    gyro_filtered_frd_y_dps : float;
    gyro_filtered_frd_z_dps : float;

    attitude_roll_deg : float;
    attitude_yaw_deg : float;
    attitude_pitch_deg : float;

    pid_outer_roll : float;
    pid_outer_yaw : float;
    pid_inner_roll : float;
    pid_inner_yaw : float;

    servo_left_upper : float;
    servo_right_upper : float;
    servo_right_lower : float;
    servo_left_lower : float;

    // 追加在表末尾：保持既有字段 ID 不变，旧 bag 仍可用新解析器解码。
    // 俯仰内环（角速度环）输出，单位 us。
    pid_inner_pitch : float;
    // 本帧的俯仰目标值（剖面参考），单位 deg。
    pitch_target_deg : float;
    // 俯仰外环（姿态环）输出，单位 deg/s。内环跟踪目标 = 剖面斜率前馈 + 本值。
    pid_outer_pitch : float;
}

root_type CarData;
